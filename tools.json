      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Search results</title>\n<style>\n:root{--bg:var(--color-background-primary,#fff);--bg2:var(--color-background-secondary,#f4f4f5);--fg:var(--color-text-primary,#18181b);--fg2:var(--color-text-secondary,#71717a);--line:var(--color-border-primary,#e4e4e7);--danger:var(--color-text-danger,#dc2626);--inv-bg:var(--color-background-inverse,#18181b);--inv-fg:var(--color-text-inverse,#fff);--r:var(--border-radius-lg,12px);--rs:var(--border-radius-md,8px);--sm:var(--font-text-sm-size,13px);--md:var(--font-text-md-size,15px);color-scheme:light dark}\n:root[data-theme=dark]{--bg:var(--color-background-primary,#212121);--bg2:var(--color-background-secondary,#2a2a2a);--fg:var(--color-text-primary,#fafafa);--fg2:var(--color-text-secondary,#a1a1aa);--line:var(--color-border-primary,#3a3a3a);--inv-bg:var(--color-background-inverse,#fafafa);--inv-fg:var(--color-text-inverse,#18181b)}\n@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:var(--color-background-primary,#212121);--bg2:var(--color-background-secondary,#2a2a2a);--fg:var(--color-text-primary,#fafafa);--fg2:var(--color-text-secondary,#a1a1aa);--line:var(--color-border-primary,#3a3a3a);--inv-bg:var(--color-background-inverse,#fafafa);--inv-fg:var(--color-text-inverse,#18181b)}}\n*{box-sizing:border-box}html,body{margin:0;background:transparent}\nbody{font-family:var(--font-sans,system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif);font-size:var(--md);line-height:1.45;color:var(--fg)}\n.card{background:var(--bg);padding:16px;display:flex;flex-direction:column;gap:12px}\n.head{display:flex;flex-direction:column;gap:2px}\n.title{margin:0;font-size:var(--md);font-weight:var(--font-weight-medium,500);overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}\n.sub{font-size:var(--sm);color:var(--fg2)}\n.sub.fail{color:var(--danger)}\n.bar{height:4px;border-radius:999px;background:var(--bg2);overflow:hidden}\n.bar>i{display:block;height:100%;width:0;background:var(--fg);opacity:.7;transition:width .8s ease}\n.event{font-size:var(--sm);color:var(--fg2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-height:1.45em}\n.excerpt{margin:0;font-size:var(--sm);overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical}\n.quotes{display:flex;flex-direction:column;gap:8px;margin:0;padding:0;list-style:none}\n.quotes li{background:var(--bg2);border-radius:var(--rs);padding:10px 12px;display:flex;flex-direction:column;gap:4px}\n.quotes p{margin:0;font-size:var(--sm)}\n.src{display:flex;gap:6px;align-items:center;font-size:12px;color:var(--fg2);min-width:0}\n.src span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.link{font:inherit;font-size:12px;color:var(--fg2);background:none;border:0;padding:0;cursor:pointer;text-decoration:underline;text-underline-offset:2px;white-space:nowrap}\n.more{align-self:flex-start}\n.actions{display:flex;gap:8px;flex-wrap:wrap}\n.btn{font:inherit;font-size:var(--sm);font-weight:var(--font-weight-medium,500);height:34px;padding:0 14px;border-radius:999px;border:1px solid var(--line);background:var(--bg);color:var(--fg);cursor:pointer;white-space:nowrap}\n.btn.primary{background:var(--inv-bg);color:var(--inv-fg);border-color:transparent}\n.btn:disabled{opacity:.6;cursor:default}\n[hidden]{display:none!important}\n</style>\n</head>\n<body>\n<div class=\"card\" id=\"card\">\n  <div class=\"head\"><p class=\"title\" id=\"q\">Searching comments</p><div class=\"sub\" id=\"sub\">Starting the search</div></div>\n  <div id=\"running\" style=\"display:flex;flex-direction:column;gap:8px\">\n    <div class=\"bar\"><i id=\"fill\"></i></div>\n    <div class=\"event\" id=\"event\"></div>\n  </div>\n  <div id=\"done\" hidden style=\"display:flex;flex-direction:column;gap:12px\">\n    <p class=\"excerpt\" id=\"excerpt\"></p>\n    <ul class=\"quotes\" id=\"quotes\"></ul>\n    <button class=\"link more\" id=\"more\" hidden></button>\n  </div>\n  <div class=\"actions\" id=\"actions\" hidden>\n    <button class=\"btn primary\" id=\"open\" hidden>Open all comments</button>\n    <button class=\"btn\" id=\"continue\" hidden>Continue in chat</button>\n  </div>\n</div>\n<script>\n(function(){\n  var PHASES={queued:\"Waiting to start\",planning:\"Planning searches\",searching:\"Searching Reddit, TikTok and YouTube\",reading:\"Reading comments\",gaps:\"Filling gaps\",analyze:\"Pulling out quotes\",extracting:\"Pulling out quotes\",writing:\"Writing the answer\",done:\"Finishing up\"};\n  var SOURCES={reddit:\"Reddit\",youtube:\"YouTube\",tiktok:\"TikTok\",facebook:\"Facebook\",instagram:\"Instagram\",amazon:\"Amazon\"};\n  var nextId=1,pending={},caps={},view=null,stopped=false,polling=false,tick=null,shared=false,shown=3;\n  var $=function(id){return document.getElementById(id)};\n  function post(m){window.parent.postMessage(m,\"*\")}\n  function rpc(method,params){var id=nextId++;post({jsonrpc:\"2.0\",id:id,method:method,params:params||{}});return new Promise(function(res,rej){pending[id]={res:res,rej:rej}})}\n  function notify(method,params){post({jsonrpc:\"2.0\",method:method,params:params||{}})}\n  window.addEventListener(\"message\",function(e){\n    if(e.source!==window.parent)return;var m=e.data;if(!m||m.jsonrpc!==\"2.0\")return;\n    if(m.id!=null&&!m.method){var p=pending[m.id];if(p){delete pending[m.id];m.error?p.rej(m.error):p.res(m.result)}return}\n    if(m.method===\"ui/notifications/tool-result\")onResult(m.params);\n    else if(m.method===\"ui/notifications/tool-input\")onInput(m.params);\n    else if(m.method===\"ui/notifications/host-context-changed\")applyContext(m.params);\n    else if(m.method===\"ui/notifications/tool-cancelled\")showError(\"The search was cancelled.\");\n    else if(m.method===\"ui/resource-teardown\"){stopped=true;if(m.id!=null)post({jsonrpc:\"2.0\",id:m.id,result:{}})}\n    else if(m.method===\"ping\"&&m.id!=null)post({jsonrpc:\"2.0\",id:m.id,result:{}});\n    else if(m.id!=null)post({jsonrpc:\"2.0\",id:m.id,error:{code:-32601,message:\"Method not found\"}});\n  });\n  function applyContext(c){\n    if(!c)return;\n    if(c.theme)document.documentElement.setAttribute(\"data-theme\",c.theme);\n    var vars=c.styles&&c.styles.variables;if(vars)for(var k in vars)if(vars[k])document.documentElement.style.setProperty(k,vars[k]);\n  }\n  function parse(result){\n    if(!result)return null;\n    if(result.structuredContent&&result.structuredContent.status)return result.structuredContent;\n    var t=result.content&&result.content[0]&&result.content[0].text;\n    if(result.isError){showError(t||\"The search could not start.\");return null}\n    try{return JSON.parse(t)}catch(_){return null}\n  }\n  function onInput(p){var a=p&&p.arguments;if(a&&!view){var t=a.query||a.question||a.angle;if(t)$(\"q\").textContent=t}}\n  function onResult(result){var v=parse(result);if(!v)return;render(v);if(!final(v))poll()}\n  function final(v){return v.status===\"completed\"||v.status===\"failed\"}\n  function render(v){\n    view=v;if(v.question)$(\"q\").textContent=v.question;\n    if(v.status===\"failed\"){showError(v.error||\"The search failed.\");return}\n    if(v.status===\"completed\"){renderDone(v);return}\n    var ph=v.progress&&v.progress.phase;$(\"sub\").textContent=PHASES[ph]||PHASES[v.status]||\"Working\";\n    var ev=v.progress&&v.progress.recent;$(\"event\").textContent=ev&&ev.length?ev[ev.length-1]:\"\";\n    startClock();\n  }\n  function elapsed(){return view?Math.max(0,Math.round((Date.now()-new Date(view.created_at).getTime())/1000)):0}\n  function startClock(){\n    if(tick)return;\n    var draw=function(){if(!view||final(view)){clearInterval(tick);tick=null;return}\n      var s=elapsed(),t=view.typical_s||90,ph=view.progress&&view.progress.phase;\n      $(\"sub\").textContent=(PHASES[ph]||PHASES[view.status]||\"Working\")+\", \"+s+\"s of about \"+t+\"s\";\n      $(\"fill\").style.width=Math.min(95,Math.round(100*s/Math.max(t,1)))+\"%\"};\n    draw();tick=setInterval(draw,1000);\n  }\n  function poll(){\n    if(polling||stopped||!view)return;\n    if(!caps.serverTools){$(\"event\").textContent=\"Ask the assistant to check the search when it finishes.\";return}\n    polling=true;\n    (function loop(){\n      if(stopped){polling=false;return}\n      rpc(\"tools/call\",{name:\"get_search\",arguments:{search_id:view.search_id,turn_id:view.turn_id}}).then(function(r){\n        var v=parse(r);if(v)render(v);\n        if(v&&final(v)){polling=false;return}\n        setTimeout(loop,1500);\n      },function(){setTimeout(loop,5000)});\n    })();\n  }\n  function coverageLine(v){\n    var cov=v.coverage||{},bits=[];\n    if(cov.comments!=null)bits.push(num(cov.comments)+\" comments read\");\n    if(cov.threads!=null)bits.push(\"from \"+num(cov.threads)+\" threads and videos\");\n    var line=bits.join(\" \");\n    if(v.quote_total)line+=(line?\", \":\"\")+num(v.quote_total)+\" quotes\";\n    return line||\"Search complete\";\n  }\n  function renderDone(v){\n    $(\"running\").hidden=true;$(\"done\").hidden=false;$(\"done\").style.display=\"flex\";\n    $(\"sub\").className=\"sub\";$(\"sub\").textContent=coverageLine(v);\n    var md=(v.answer&&v.answer.markdown)||\"\";$(\"excerpt\").textContent=plain(md);$(\"excerpt\").hidden=!md;\n    drawQuotes(v);\n    var open=$(\"open\"),cont=$(\"continue\"),any=false;\n    if(v.sources_url&&caps.openLinks){open.hidden=false;any=true;open.onclick=function(){link(v.sources_url)}}\n    if(caps.message){cont.hidden=false;any=true;cont.onclick=function(){cont.disabled=true;\n      rpc(\"ui/message\",{role:\"user\",content:[{type:\"text\",text:\"Use the BuzzSearch results for \\\"\"+(v.question||\"\")+\"\\\" (search_id \"+v.search_id+\") to answer.\"}]}).catch(function(){cont.disabled=false})}}\n    $(\"actions\").hidden=!any;\n    share(v);\n  }\n  function drawQuotes(v){\n    var all=v.top_quotes||[],qs=all.slice(0,shown);\n    $(\"quotes\").innerHTML=qs.map(function(q,i){\n      var who=[SOURCES[q.source]||q.source||\"\",q.author||\"\"].filter(Boolean).map(esc).join(\", \");\n      var open=q.url&&caps.openLinks?'<button class=\"link\" data-i=\"'+i+'\">Open</button>':\"\";\n      return \"<li><p>\"+esc(q.quote||\"\")+\"</p><div class=src><span>\"+who+\"</span>\"+open+\"</div></li>\"}).join(\"\");\n    Array.prototype.forEach.call(document.querySelectorAll(\"button[data-i]\"),function(b){\n      b.addEventListener(\"click\",function(){var q=qs[+b.getAttribute(\"data-i\")];if(q)link(q.url)})});\n    var more=$(\"more\"),rest=Math.min(all.length,10)-qs.length;\n    more.hidden=rest<=0;more.textContent=\"Show \"+rest+\" more\";more.onclick=function(){shown=10;drawQuotes(v)};\n  }\n  function link(url){rpc(\"ui/open-link\",{url:url}).catch(function(){})}\n  function share(v){\n    if(shared)return;shared=true;\n    var md=(v.answer&&v.answer.markdown)||\"\",qs=(v.top_quotes||[]).slice(0,10);\n    var text=\"BuzzSearch search \"+v.search_id+\" (turn \"+v.turn_id+\") completed for: \"+(v.question||\"\")+\"\\n\\nAnswer:\\n\"+md.slice(0,6000)+\n      \"\\n\\nTop quotes:\\n\"+qs.map(function(q){return \"- \\\"\"+(q.quote||\"\")+\"\\\" (\"+(q.source||\"\")+(q.url?\", \"+q.url:\"\")+\")\"}).join(\"\\n\")+\n      (v.sources_url?\"\\n\\nAll comments and sources: \"+v.sources_url:\"\")+\n      \"\\n\\nMore with get_quotes, get_sources and get_comments on this search_id.\";\n    rpc(\"ui/update-model-context\",{content:[{type:\"text\",text:text}]}).catch(function(){});\n  }\n  function showError(msg){$(\"running\").hidden=true;$(\"sub\").className=\"sub fail\";$(\"sub\").textContent=msg}\n  function num(n){return Number(n).toLocaleString(document.documentElement.lang||undefined)}\n  function esc(s){return String(s).replace(/[&<>\"']/g,function(c){return{\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[c]})}\n  function plain(md){return md.replace(/^#+.*$/gm,\"\").replace(/\\s*\\[(q|s):[^\\]]*\\]/g,\"\").replace(/[#*_>`]/g,\"\").replace(/\\[([^\\]]+)\\]\\([^)]*\\)/g,\"$1\").replace(/\\s+/g,\" \").trim()}\n  if(typeof ResizeObserver!==\"undefined\")new ResizeObserver(function(){notify(\"ui/notifications/size-changed\",{height:Math.ceil(document.documentElement.getBoundingClientRect().height)})}).observe(document.documentElement);\n  rpc(\"ui/initialize\",{appInfo:{name:\"BuzzSearch\",version:\"2.0.0\"},appCapabilities:{},protocolVersion:\"2026-01-26\"}).then(function(r){\n    caps=(r&&r.hostCapabilities)||{};applyContext(r&&r.hostContext);notify(\"ui/notifications/initialized\",{});\n    if(view){render(view);if(!final(view))poll()}\n  },function(){});\n})();\n</script>\n</body>\n</html>"
    }
